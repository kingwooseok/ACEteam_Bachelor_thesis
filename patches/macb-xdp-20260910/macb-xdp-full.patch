+static void macb_tx_kick(struct macb_queue *queue, bool wake_lpi,
+			 bool arm_retry)
+{
+	struct macb *bp = queue->bp;
+
+	spin_lock(&bp->lock);
+
+	if (wake_lpi)
+		macb_tx_lpi_wake(bp);
+
+	/* TSTART can be lost while TX is already running.  Leave a
+	 * breadcrumb so a subsequent TX interrupt retries the doorbell.
+	 */
+	if (arm_retry && (macb_readl(bp, TSR) & MACB_BIT(TGO)))
+		queue->tx_pending = true;
+
+	macb_writel(bp, NCR, macb_readl(bp, NCR) | MACB_BIT(TSTART));
+
+	/* Flush PCIe posted writes so the doorbell reaches RP1 before the
+	 * caller returns.
+	 */
+	if (bp->caps & MACB_CAPS_PCIE_POSTED_WRITES)
+		(void)macb_readl(bp, NCR);
+	spin_unlock(&bp->lock);
+}
