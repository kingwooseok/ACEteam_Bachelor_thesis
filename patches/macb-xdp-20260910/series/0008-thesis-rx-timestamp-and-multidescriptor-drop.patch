+	desc_ptp = macb_ptp_desc(bp, desc);
+	if (!desc_ptp)
+		return -EOPNOTSUPP;
+
+	/* Ensure the extended descriptor words are read after RX ownership. */
+	dma_rmb();
+	gem_hw_timestamp(bp, desc_ptp->ts_1, desc_ptp->ts_2, &ts);
+	*timestamp = timespec64_to_ns(&ts);
+
+	return 0;
+}
