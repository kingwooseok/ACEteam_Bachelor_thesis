+/* SKB timestamp와 XDP metadata가 같은 RX descriptor 해석을 쓰도록 분리했다.
+ * SKB가 아직 없는 native XDP 지점에서도 호출할 수 있게 결과는 u64 ns로 준다.
+ * 이 값은 NIC PHC 시계의 수신 시간이며 CPU의 CLOCK_MONOTONIC 값이 아니다.
+ * gem_hw_timestamp()가 descriptor에 없는 초 상위 비트를 현재 TSU로 보완한다.
+ * 필터가 꺼졌거나 이 descriptor에 유효한 HW 값이 없으면 소프트웨어 시간을
+ * 대신 만들지 않고 오류를 반환한다. 측정 코드는 그 표본을 구분해 기록한다.
+ */
+int gem_ptp_rxstamp_ns(struct macb *bp, struct macb_dma_desc *desc,
+		       u64 *timestamp)
+{
+	struct macb_dma_desc_ptp *desc_ptp;
+	struct timespec64 ts;
+
+	if (!READ_ONCE(bp->ptp_clock) ||
+	    bp->tstamp_config.rx_filter == HWTSTAMP_FILTER_NONE ||
+	    !GEM_BFEXT(DMA_RXVALID, desc->addr))
+		return -ENODATA;
+
+	desc_ptp = macb_ptp_desc(bp, desc);
+	if (!desc_ptp)
+		return -EOPNOTSUPP;
+
+	/* Ensure the extended descriptor words are read after RX ownership. */
+	dma_rmb();
+	gem_hw_timestamp(bp, desc_ptp->ts_1, desc_ptp->ts_2, &ts);
+	*timestamp = timespec64_to_ns(&ts);
+
+	return 0;
