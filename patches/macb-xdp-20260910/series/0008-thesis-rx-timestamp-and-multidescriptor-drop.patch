+		       u64 *timestamp)
+{
+	struct macb_dma_desc_ptp *desc_ptp;
+	struct timespec64 ts;
+
+	if (!READ_ONCE(bp->ptp_clock) ||
+	    bp->tstamp_config.rx_filter == HWTSTAMP_FILTER_NONE ||
+	    !GEM_BFEXT(DMA_RXVALID, desc->addr))
+		return -ENODATA;
